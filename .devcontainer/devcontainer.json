{
  "name": "FarmaRed – MongoDB + Redis",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "pip install --user -e '.[dev]' && sudo apt-get update -qq && sudo apt-get install -y -qq redis-tools",
  "forwardPorts": [
    8000,
    "mongo:27017",
    "redis:6379"
  ],
  "portsAttributes": {
    "8000": {
      "label": "API FarmaRed (Swagger en /docs)"
    },
    "mongo:27017": {
      "label": "MongoDB"
    },
    "redis:6379": {
      "label": "Redis"
    }
  }
}
